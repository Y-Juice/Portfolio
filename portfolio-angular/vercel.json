{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist/portfolio-angular/browser" }
    }
  ],
  "routes": [
    { "src": "/favicon.ico", "dest": "/favicon.ico" },
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/(.*\\.[a-z0-9]+$)", "dest": "/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}

